# TarelGo CaptchAI configuration (TarelGo Development - https://tarelgo.com)
# Copy to /opt/tarelgo-captchai/.env and fill in the secrets.
# Every variable uses the TARELGO_CAPTCHAI_ prefix - safe on a shared VPS.

# --- protection mode of branch B -------------------------------------------
# strict      - only RFC 9421 Web Bot Auth signatures open branch B.
# best_effort - additionally accepts one-shot capability tokens (/ai-token).
TARELGO_CAPTCHAI_MODE=best_effort

# --- secrets (comma-separated; the FIRST one is active, rest = rotation) ----
# Generate: openssl rand -base64 36 | tr -d '\n' | tr '/+' '_-'
TARELGO_CAPTCHAI_SECRETS=replace-me-with-openssl-rand-base64-36-output-aaaa
TARELGO_CAPTCHAI_TOKEN_TTL=120
TARELGO_CAPTCHAI_TOKEN_BIND_UA=true

# --- storage: PostgreSQL OR MariaDB (pick ONE) -------------------------------
# PostgreSQL (asyncpg driver, extra: pip install .[postgres]):
#TARELGO_CAPTCHAI_DB_DSN=postgresql://tarelgo:secret@127.0.0.1:5432/tarelgo_captchai
# MariaDB (aiomysql driver, extra: pip install .[mariadb]):
#TARELGO_CAPTCHAI_DB_DSN=mysql://tarelgo:secret@127.0.0.1:3306/tarelgo_captchai
# No DB at all (dev/test, single process only):
#TARELGO_CAPTCHAI_ALLOW_MEMORY=true
TARELGO_CAPTCHAI_LOG_RETENTION_DAYS=7

# --- detection and scoring ------------------------------------------------------
TARELGO_CAPTCHAI_THRESHOLD=3
# Optional external lists (one token/hash per line, '#' comments):
TARELGO_CAPTCHAI_UA_AI_LIST_FILE=
TARELGO_CAPTCHAI_JA3_LIST_FILE=
# Header carrying the JA3 hash from a TLS-terminating proxy (optional):
TARELGO_CAPTCHAI_JA3_HEADER=X-JA3-Hash

# --- rate limiting --------------------------------------------------------------
# Format: N/window-seconds
TARELGO_CAPTCHAI_RATELIMIT_AI_TOKEN=5/600
TARELGO_CAPTCHAI_RATELIMIT_B=100/60
TARELGO_CAPTCHAI_BAN_SECONDS=900

# --- proxy chain (nginx -> Apache -> uvicorn, nginx -> uvicorn, Apache -> uvicorn,
#     or none). X-Forwarded-For is trusted only when the direct peer matches:
TARELGO_CAPTCHAI_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Override the @authority reconstruction if a proxy rewrites the Host header:
TARELGO_CAPTCHAI_PUBLIC_AUTHORITY=

# --- Web Bot Auth ---------------------------------------------------------------
TARELGO_CAPTCHAI_WBA_MAX_AGE=600
TARELGO_CAPTCHAI_WBA_CLOCK_SKEW=5
TARELGO_CAPTCHAI_WBA_REQUIRE_METHOD_PATH=true
TARELGO_CAPTCHAI_WBA_REQUIRE_AGENT=true
TARELGO_CAPTCHAI_WBA_DIRECTORY_TTL=3600
TARELGO_CAPTCHAI_WBA_NEGATIVE_TTL=600
TARELGO_CAPTCHAI_WBA_FETCH_TIMEOUT=2.0
TARELGO_CAPTCHAI_WBA_MAX_DIR_BYTES=65536
# NEVER enable in production (SSRF protection):
TARELGO_CAPTCHAI_WBA_ALLOW_PRIVATE_KEYHOST=false

# --- service ---------------------------------------------------------------------
TARELGO_CAPTCHAI_BIND_HOST=127.0.0.1
TARELGO_CAPTCHAI_BIND_PORT=8008
TARELGO_CAPTCHAI_LOG_LEVEL=INFO
# /metrics visibility: trusted proxies only, unless a metrics token is set:
TARELGO_CAPTCHAI_METRICS_PRIVATE_ONLY=true
TARELGO_CAPTCHAI_METRICS_TOKEN=
# Optional custom payloads for branch A / branch B:
TARELGO_CAPTCHAI_CONTENT_A_FILE=
TARELGO_CAPTCHAI_CONTENT_B_FILE=
